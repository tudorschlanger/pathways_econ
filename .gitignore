# ==============================================================================
# .gitignore for Pathways Project
# ==============================================================================

# LaTeX build artifacts
*.aux
*.bbl
*.blg
*.fdb_latexmk
*.fls
*.log
*.nav
*.out
*.snm
*.toc
*.vrb
*.synctex.gz
*.run.xml
*-blx.bib

# Compiled PDFs and presentations
*.pdf
*.pptx

# Allow PDFs in output/
!output/**/*.pdf

# Python
__pycache__/
*.pyc
*.pyo

# OS files
.DS_Store
Thumbs.db

# Claude Code local files (not shared across machines)
.claude/settings.local.json
.claude/state/
CLAUDE.local.md

# Project data, docs, and internal files
/[Dd]oc/
/data/
/quality_reports/
/templates/
MEMORY.md
notes.md

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

